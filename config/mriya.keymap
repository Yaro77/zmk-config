#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        toFn {
            bindings = <&to 0>;
            key-positions = <49 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
  &none       &none  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp LEFT_BRACE  &kp RIGHT_BRACE     &kp SINGLE_QUOTE  &kp GRAVE   &kp MINUS      &kp EQUAL
  &kp ESCAPE  &kp Q  &kp W             &kp E              &kp R                 &kp T                    &kp Y           &kp U               &kp I             &kp O       &kp P          &none
  &kp TAB     &kp A  &mt LALT S        &mt LSHIFT D       &mt LCTRL F           &kp G                    &kp H           &mt LEFT_CONTROL J  &mt LSHIFT K      &mt LALT L  &kp SEMICOLON  &kp BACKSPACE
  &none       &kp Z  &kp X             &kp C              &kp V                 &kp B                    &kp N           &kp M               &kp COMMA         &kp PERIOD  &kp SLASH      &kp ENTER
                     &none             &none              &none                 &none                    &none           &none               &none             &none
            >;
        };

        numbers {
            bindings = <
  &trans  &kp F11  &kp F12      &trans         &trans        &trans    &trans    &trans        &trans         &trans       &trans     &trans
  &trans  &kp F1   &kp F2       &kp F3         &kp F4        &kp F5    &kp F6    &kp F7        &kp F8         &kp F9       &kp F10    &kp PAGE_UP
  &trans  &kp N1   &mt LALT N2  &mt LSHIFT N3  &mt LCTRL N4  &kp N5    &kp N6    &mt LCTRL N7  &mt LSHIFT N8  &mt LALT N9  &kp N0     &kp PAGE_DOWN
  &trans  &trans   &trans       &trans         &trans        &trans    &kp HOME  &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT  &kp END
                   &trans       &trans         &none         &trans    &trans    &trans        &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &none   &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
