#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        toFn {
            bindings = <&to 0>;
            key-positions = <49 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
  &none       &none  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE      &kp RIGHT_BRACE    &none  &none               &none             &none           &none          &none
  &kp ESCAPE  &kp Q  &kp W                 &kp E                  &kp R               &kp T              &kp Y  &kp U               &kp I             &kp O           &kp P          &none
  &kp TAB     &kp A  &mt LEFT_ALT S        &mt LEFT_SHIFT D       &mt LEFT_CONTROL F  &kp G              &kp H  &mt LEFT_CONTROL J  &mt LEFT_SHIFT K  &mt LEFT_ALT L  &kp SEMICOLON  &kp BACKSPACE
  &none       &kp Z  &kp X                 &kp C                  &kp V               &kp B              &kp N  &kp M               &kp COMMA         &kp PERIOD      &kp SLASH      &none
                     &none                 &none                  &kp SPACE           &kp BACKSPACE      &none  &kp ENTER           &none             &none
            >;
        };

        numbers {
            bindings = <
  &trans  &kp F11  &kp F12          &trans             &trans               &trans    &trans  &trans               &trans             &trans           &trans   &trans
  &trans  &kp F1   &kp F2           &kp F3             &kp F4               &kp F5    &kp F6  &kp F7               &kp F8             &kp F9           &kp F10  &none
  &trans  &kp N1   &mt LEFT_ALT N2  &mt LEFT_SHIFT N3  &mt LEFT_CONTROL N4  &kp N5    &kp N6  &mt LEFT_CONTROL N7  &mt LEFT_SHIFT N8  &mt LEFT_ALT N9  &kp N0   &none
  &trans  &trans   &trans           &trans             &trans               &trans    &none   &none                &none              &none            &none    &none
                   &trans           &trans             &none                &trans    &trans  &trans               &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
  &trans  &trans  &trans        &trans          &trans            &trans    &trans      &trans            &trans          &trans          &trans           &trans
  &trans  &trans  &trans        &trans          &trans            &trans    &kp INSERT  &trans            &trans          &trans          &trans           &kp PAGE_UP
  &trans  &trans  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans    &kp DELETE  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT    &none            &kp PAGE_DOWN
  &trans  &trans  &trans        &trans          &trans            &trans    &kp HOME    &kp LEFT_ARROW    &kp UP_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
                  &trans        &none           &trans            &trans    &trans      &trans            &trans          &trans
            >;
        };
    };
};
