#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        toFn {
            bindings = <&to 0>;
            key-positions = <49 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
  &none  &none  &none       &none         &none        &none        &none      &none               &none         &none       &none          &none
  &none  &kp Q  &kp W       &kp E         &kp R        &kp T        &kp Y      &kp U               &kp I         &kp O       &kp P          &none
  &none  &kp A  &mt LALT S  &mt LSHIFT D  &mt LCTRL F  &kp G        &kp H      &mt LEFT_CONTROL J  &mt LSHIFT K  &mt LALT L  &kp SEMICOLON  &none
  &none  &kp Z  &kp X       &kp C         &kp V        &kp B        &kp N      &kp M               &kp COMMA     &kp PERIOD  &kp SLASH      &none
                &none       &to 2         &to 1        &kp SPACE    &kp ENTER  &kp BACKSPACE       &kp DELETE    &none
            >;
        };

        layer_1 {
            bindings = <
  &none  &none  &kt N9       &kp N8        &kp N7        &none     &none   &none     &none     &none      &none  &none
  &none  &none  &kp N6       &kp N5        &kp N4        &none     &none   &none     &none     &none      &none  &none
  &none  &none  &mt LALT N3  &mt LSHFT N2  &mt LCTRL N1  &none     &none   &kp LEFT  &kp UP    &kp RIGHT  &none  &none
  &none  &none  &none        &none         &kp N0        &none     &none   &none     &kp DOWN  &none      &none  &none
                &none        &trans        &to 0         &trans    &trans  &none     &none     &none
            >;
        };

        layer_2 {
            bindings = <
  &none  &none  &kp F9       &kp F8         &kp F7        &none    &none  &none      &none       &none     &none  &none
  &none  &none  &kp F6       &kp F5         &kp F4        &none    &none  &none      &none       &none     &none  &none
  &none  &none  &mt LALT F3  &mt LSHIFT F2  &mt LCTRL F1  &none    &none  &kp LCTRL  &kp LSHIFT  &kp LALT  &none  &none
  &none  &none  &kp F11      &kp F12        &kp F10       &none    &none  &none      &none       &none     &none  &none
                &none        &to 0          &trans        &none    &none  &none      &none       &none
            >;
        };
    };
};
