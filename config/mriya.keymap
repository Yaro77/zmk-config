#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        toFn {
            bindings = <&to 0>;
            key-positions = <49 54>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
  &none  &none  &none       &none         &none        &none        &none      &none               &none         &none       &none          &none
  &none  &kp Q  &kp W       &kp E         &kp R        &kp T        &kp Y      &kp U               &kp I         &kp O       &kp P          &none
  &none  &kp A  &mt LALT S  &mt LSHIFT D  &mt LCTRL F  &kp G        &kp H      &mt LEFT_CONTROL J  &mt LSHIFT K  &mt LALT L  &kp SEMICOLON  &none
  &none  &kp Z  &kp X       &kp C         &kp V        &kp B        &kp N      &kp M               &kp COMMA     &kp PERIOD  &kp SLASH      &none
                &none       &to 2         &to 1        &kp SPACE    &kp ENTER  &kp BACKSPACE       &kp DELETE    &none
            >;
        };

        numbers {
            bindings = <
  &trans  &kp F11  &kp F12      &trans         &trans        &trans    &trans  &trans        &trans         &trans       &trans     &trans
  &trans  &kp F1   &kp F2       &kp F3         &kp F4        &kp F5    &kp F6  &kp F7        &kp F8         &kp F9       &kp F10    &trans
  &trans  &kp N1   &mt LALT N2  &mt LSHIFT N3  &mt LCTRL N4  &kp N5    &kp N6  &mt LCTRL N7  &mt LSHIFT N8  &mt LALT N9  &kp N0     &trans
  &trans  &trans   &trans       &trans         &trans        &trans    &none   &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT  &trans
                   &trans       &trans         &to 0         &trans    &trans  &trans        &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                  &trans  &to 0   &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
